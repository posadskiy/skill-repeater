# === Stage 1: Build the application ===
FROM maven:3.9.12-amazoncorretto-25-alpine AS build
WORKDIR /app

COPY . .

RUN --mount=type=cache,target=/root/.m2 \
    mvn -B clean install -pl skill-repeater-web -am -DskipTests

# === Stage 2: Create the runtime image ===
FROM eclipse-temurin:25-jre-alpine
WORKDIR /app

RUN addgroup -g 1000 -S app && adduser -u 1000 -S app -G app

COPY --from=build --chown=app:app /app/skill-repeater-web/target/skill-repeater-web-*.jar app.jar

USER app

ENV MICRONAUT_ENVIRONMENTS=prod

EXPOSE 8210

ENTRYPOINT ["java", "-jar", "app.jar"]
